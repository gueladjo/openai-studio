{
  "name": "openai-studio",
  "private": true,
  "version": "0.6.1",
  "main": "electron/main.js",
  "author": "OpenAI Studio User",
  "description": "A professional chat interface for OpenAI GPT-5 models.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc && vite build --mode electron",
    "build:web": "tsc && vite build --mode web",
    "build:electron": "tsc && vite build --mode electron",
    "preview": "vite preview",
    "electron:dev": "concurrently --kill-others --success first --names vite,electron \"vite --mode electron\" \"electron .\"",
    "dist": "npm run build:electron && electron-builder",
    "deploy": "npm run build:web && gh-pages -d dist"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@zip.js/zip.js": "^2.8.34",
    "lucide-react": "^0.344.0",
    "openai": "^6.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.2",
    "concurrently": "^8.2.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.16",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.2.2",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.openaistudio.app",
    "productName": "OpenAI Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
