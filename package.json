{
  "name": "openai-studio",
  "private": true,
  "version": "0.8.0",
  "main": "electron/main.js",
  "author": "OpenAI Studio User",
  "description": "A professional chat interface for OpenAI GPT-5 models.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "dev": "vite",
    "test": "vitest run",
    "build": "tsc && vite build --mode electron",
    "build:web": "tsc && vite build --mode web",
    "build:electron": "tsc && vite build --mode electron",
    "preview": "vite preview",
    "electron:dev": "concurrently --kill-others --success first --names vite,electron \"vite --mode electron\" \"electron .\"",
    "dist": "npm run build:electron && electron-builder",
    "deploy": "npm run build:web && gh-pages -d dist"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@zip.js/zip.js": "^2.8.34",
    "lucide-react": "^1.28.0",
    "openai": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "fake-indexeddb": "^6.2.5",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.11.1",
    "postcss": "^8.5.16",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.openaistudio.app",
    "productName": "OpenAI Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
